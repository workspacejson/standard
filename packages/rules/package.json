{
  "name": "@workspacejson/rules",
  "version": "0.4.4",
  "description": "Deterministic reference behavior for workspace.json: AGENTS.md parser, repository scanner, validator and rule engine",
  "license": "Apache-2.0",
  "author": "workspacejson contributors",
  "homepage": "https://workspacejson.dev",
  "keywords": [
    "workspace.json",
    "ai-agents",
    "ai-coding-agents",
    "codebase-intelligence",
    "open-standard",
    "json-schema",
    "developer-tools",
    "AGENTS.md",
    "claude-code",
    "cursor",
    "goose",
    "cline"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workspacejson/standard.git",
    "directory": "packages/rules"
  },
  "bugs": {
    "url": "https://github.com/workspacejson/standard/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing/rule-tester.js",
      "types": "./dist/testing/rule-tester.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/testing/rule-tester.ts --format esm --dts --external vitest",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test && node ../../scripts/verify-package-tarball.mjs"
  },
  "dependencies": {
    "@workspacejson/spec": "workspace:*",
    "ajv": "^8.16.0",
    "dedent": "^1.5.3",
    "fast-glob": "^3.3.2",
    "ignore": "^7.0.6",
    "remark": "^15.0.0",
    "remark-parse": "^11.0.0",
    "simple-git": "^3.25.0",
    "unified": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
